rules_version = '2';

// Default is deny. A user can read and write only their own account.
// Rank is not a stored field. Streak can move by at most one day per write.
// Username is the only profile field a user can change. The case-insensitive
// reservation lives at usernames/{handle} and stores uid plus the display
// name, never email or progress. The owner can delete their account document
// and their workout logs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isNewUser();
      allow update: if isOwner(uid) && (isSkillUpdate() || isStreakUpdate() || isUsernameUpdate());
      allow delete: if isOwner(uid);

      match /workoutLogs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isWorkoutLog();
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /usernames/{handle} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isUsernameReservation(handle);
      allow update: if isUsernameReservation(handle)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function isHandle(handle) {
  return handle is string
    && handle.matches('^[a-z0-9][a-z0-9 _-]{1,23}$')
    && !handle.matches('.*  .*')
    && !handle.matches('.* $');
}

function isDisplayName(name) {
  return name is string
    && name.matches('^[A-Za-z0-9][A-Za-z0-9 _-]{1,23}$')
    && !name.matches('.*  .*')
    && !name.matches('.* $');
}

function isUsernameReservation(handle) {
  let data = request.resource.data;
  let name = data.username;
  return isSignedIn()
    && isHandle(handle)
    && data.keys().hasOnly(['uid', 'username'])
    && data.uid is string
    && data.uid == request.auth.uid
    && isDisplayName(name)
    && name.lower() == handle;
}

function isNewUser() {
  let data = request.resource.data;
  return data.keys().hasOnly([
      'schemaVersion',
      'email',
      'authUID',
      'createdAt',
      'streak',
      'workout',
      'rest',
      'skills'
    ])
    && data.schemaVersion == 2
    && data.email == request.auth.token.email
    && data.authUID == request.auth.uid
    && data.createdAt == request.time
    && data.workout == 0
    && data.rest == 0
    && data.streak.keys().hasOnly(['current', 'longest', 'lastLog'])
    && data.streak.current == 0
    && data.streak.longest == 0
    && data.streak.lastLog == null
    && data.skills.keys().hasOnly(['push', 'pull'])
    && data.skills.push == null
    && data.skills.pull == null;
}

function isUsernameUpdate() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  let name = request.resource.data.username;
  let lower = request.resource.data.usernameLower;
  return changed.hasOnly(['username', 'usernameLower'])
    && name is string
    && lower is string
    && (
      (name == '' && lower == '')
      || (isDisplayName(name) && lower == name.lower())
    );
}

function isSkillUpdate() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  let skills = request.resource.data.skills;
  let diff = skills.diff(beforeSkills());
  // One skill key is added or changed. Checking every skill here used to
  // exceed the 1000-expression cap, so only that key is validated below.
  // 120 covers the catalog plus push/pull and some legacy keys, and keeps
  // the key lookup itself under the cap.
  return changed.hasOnly(['skills', 'updatedAt'])
    && request.resource.data.updatedAt == request.time
    && skills is map
    && skills.size() <= 120
    && diff.removedKeys().size() == 0
    && diff.affectedKeys().size() == 1
    && changedSkillOk(skills, diff);
}

function isStreakUpdate() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  let next = request.resource.data;
  let previousStreak = resource.data.get('streak', {
    'current': 0,
    'longest': 0,
    'lastLog': null
  });
  let previousWorkout = counter(resource.data, 'workout');
  let previousRest = counter(resource.data, 'rest');
  let nextCurrent = next.streak.current;
  let nextLongest = next.streak.longest;
  let nextLog = next.streak.lastLog;
  return changed.hasOnly(['streak', 'workout', 'rest'])
    && next.streak.keys().hasOnly(['current', 'longest', 'lastLog'])
    && nextCurrent is int
    && nextLongest is int
    && next.workout is int
    && next.rest is int
    && previousStreak.current is int
    && previousStreak.longest is int
    && plausibleDay(nextLog)
    && lastLogMovesForward(previousStreak.lastLog, nextLog)
    && nextCurrent == expectedCurrent(previousStreak, nextLog)
    && nextLongest == expectedLongest(previousStreak.longest, nextCurrent)
    && next.workout >= 0
    && next.rest >= 0
    && (
      (next.workout == previousWorkout + 1 && next.rest == previousRest)
      || (next.rest == previousRest + 1 && next.workout == previousWorkout)
    );
}

function isWorkoutLog() {
  let data = request.resource.data;
  return request.resource.size() < 20000
    && data.keys().hasOnly(['date', 'category', 'sections', 'loggedAt'])
    && data.loggedAt == request.time
    && data.date is string
    && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
    && parsedDay(data.date) <= request.time + duration.value(36, 'h')
    && data.category in ['push', 'pull', 'legs', 'full-body', 'conditioning']
    && data.sections is map
    && data.sections.keys().hasOnly(['warmup', 'primary', 'secondary', 'volume'])
    && data.sections.keys().hasAll(['warmup', 'primary', 'secondary', 'volume'])
    && data.sections.warmup is list
    && data.sections.warmup.size() <= 2
    && data.sections.primary is list
    && data.sections.primary.size() <= 2
    && data.sections.secondary is list
    && data.sections.secondary.size() <= 3
    && data.sections.volume is list
    && data.sections.volume.size() <= 3;
}

function beforeSkills() {
  return resource.data.keys().hasAny(['skills']) && resource.data.skills is map
    ? resource.data.skills
    : {};
}

function counter(data, key) {
  return data.keys().hasAny([key]) && data[key] is int ? data[key] : 0;
}

function parsedDay(dateStr) {
  return timestamp.date(
    int(dateStr[0:4]),
    int(dateStr[5:7]),
    int(dateStr[8:10])
  );
}

function plausibleDay(dateStr) {
  return dateStr is string
    && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$')
    && parsedDay(dateStr) >= request.time - duration.value(50, 'h')
    && parsedDay(dateStr) <= request.time + duration.value(36, 'h');
}

function lastLogMovesForward(previousLog, nextLog) {
  return previousLog == null || (previousLog is string && nextLog > previousLog);
}

function expectedCurrent(previousStreak, nextLog) {
  return previousStreak.lastLog is string && isNextDay(previousStreak.lastLog, nextLog)
    ? previousStreak.current + 1
    : 1;
}

function isNextDay(previousLog, nextLog) {
  return parsedDay(nextLog) == parsedDay(previousLog) + duration.value(1, 'd');
}

function expectedLongest(previousLongest, nextCurrent) {
  return nextCurrent > previousLongest ? nextCurrent : previousLongest;
}

function progressIds() {
  return [
    'assisted-push-up',
    'push-up',
    'dip',
    'elbow-lever',
    'planche-lean',
    'pseudo-push-up',
    'tuck-planche',
    'tuck-planche-pu',
    'adv-tuck-planche',
    'adv-tuck-planche-pu',
    '90-degree-hold',
    'back-lever',
    'super-adv-tuck-pl',
    'straddle-planche',
    'straddle-planche-pu',
    'half-lay-planche',
    'full-planche',
    'full-planche-pu',
    'one-arm-planche',
    'maltese',
    'pike-push-up',
    'crow-pose',
    'assisted-handstand',
    'handstand',
    'elevated-pike-pu',
    'bent-arm-press-to-hs',
    'straight-arm-press-to-hs',
    'bent-arm-stand',
    'assisted-hspu',
    'hspu',
    'deep-hspu',
    '90-degree-pu',
    'assisted-oahs',
    'oahs',
    'oa-flag',
    'assisted-inverted-row',
    'inverted-row',
    'tuck-fl',
    'tuck-fl-row',
    'pike-fl',
    'pike-fl-row',
    'adv-tuck-fl',
    'super-adv-tuck-fl',
    'adv-tuck-fl-row',
    'straddle-fl',
    'straddle-fl-row',
    'half-lay-fl',
    'full-front-lever',
    'full-fl-row',
    'front-lever-touch',
    'deadhang',
    'active-hang',
    'assisted-pull-up',
    'pull-up',
    'scapula pull-up',
    'chest pull-up',
    'waist pull-up',
    'muscle-up',
    'archer-pull-up',
    'clean-muscle-up',
    'assisted-oac',
    'assisted-oap',
    'oac-oap',
    'weighted-pull-ups',
    'butterfly',
    'bodyweight-squat',
    'split-squat',
    'assisted-pistol-squat',
    'bulgarian-split-squat',
    'reverse-nordic-curl',
    'nordic-curl',
    'sissy-squat',
    'pistol-squat',
    'shrimp-squat',
    'dragon-pistol-squat',
    'sit-up',
    'hollow-body-hold',
    'l-sit-compression',
    'l-sit',
    'dragon-flag',
    'v-sit',
    'i-sit',
    'manna',
    'human-flag',
    'victorian'
  ];
}

// affectedKeys() is a set, and rules cannot read a set entry by index.
// Eight halvings reduce a map of at most 256 keys to one index. The size
// check in isSkillUpdate keeps this lookup under the expression cap.
function changedSkillOk(skills, diff) {
  let keys = skills.keys();
  let changed = diff.affectedKeys();
  let id = narrowedId(keys, changed);
  return changed.hasAny([id])
    && progressIds().hasAny([id])
    && skills[id] is int
    && skills[id] >= 0
    && skills[id] <= 3;
}

function narrowedId(keys, changed) {
  let half = narrow4(0, keys.size(), keys, changed);
  let done = narrow4(half[0], half[1], keys, changed);
  return keys[done[0]];
}

function narrow4(start, end, keys, changed) {
  let a = narrow(start, end, keys, changed);
  let b = narrow(a[0], a[1], keys, changed);
  let c = narrow(b[0], b[1], keys, changed);
  let d = narrow(c[0], c[1], keys, changed);
  return d;
}

function narrow(start, end, keys, changed) {
  let mid = int((start + end) / 2);
  return mid > start && changed.hasAny(keys[start:mid])
    ? [start, mid]
    : [mid, end];
}
